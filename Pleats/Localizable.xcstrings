    "Soft and breathy, like a pump organ": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumuşak ve nefesli, pompalı org gibi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suave y con aire, como un armonio de pedal"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suave e aerado, como um harmônio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weich und luftig, wie ein Harmonium"
          }
        }
      }
    },
    "Song complete!": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkı tamam!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Canción completa!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Música completa!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lied geschafft!"
          }
        }
      }
    },
    "Songs": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkılar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canciones"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Músicas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lieder"
          }
        }
      }
    },
    "Songs light up the next button for you. Take your time; the song waits.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkılar sıradaki düğmeyi sizin için yakar. Acele etmeyin; şarkı sizi bekler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones te iluminan el siguiente botón. Tómate tu tiempo; la canción te espera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas acendem o próximo botão para você. Sem pressa; a música espera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lieder lassen den nächsten Knopf für dich leuchten. Lass dir Zeit; das Lied wartet."
          }
        }
      }
    },
    "Start over": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baştan başla"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar de nuevo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomeçar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von vorn"
          }
        }
      }
    },
    "Start playing": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalmaya başla"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar a tocar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar a tocar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Losspielen"
          }
        }
      }
    },
    "Steady air": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabit hava"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aire constante"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar constante"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichmäßige Luft"
          }
        }
      }
    },
    "Steady air keeps the reeds sounding without pumping, for practice or if moving the bellows is hard.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabit hava, pompalamadan dillerin ses vermesini sağlar; alıştırma için ya da körüğü oynatmak zorsa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aire constante mantiene sonando las lengüetas sin bombear, para practicar o si mover el fuelle cuesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ar constante mantém as palhetas soando sem bombear, para praticar ou se mover o fole for difícil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichmäßige Luft lässt die Stimmzungen ohne Pumpen klingen, zum Üben oder wenn das Balgziehen schwerfällt."
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp"
          }
        }
      }
    },
    "Stop listening": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlemeyi durdur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de escuchar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar de ouvir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhören beenden"
          }
        }
      }
    },
    "Stop recording": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydı durdur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener grabación"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar gravação"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme beenden"
          }
        }
      }
    },
    "Tap the record button, play, and tap it again. Your clip appears here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt düğmesine dokunun, çalın, yeniden dokunun. Kaydınız burada görünür."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de grabar, toca música y vuelve a pulsarlo. Tu clip aparecerá aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão de gravar, toque e toque nele de novo. Sua gravação aparece aqui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Aufnehmen, spiel und tippe erneut. Deine Aufnahme erscheint hier."
          }
        }
      }
    },
    "Ten more songs: an original tango, The Entertainer, Greensleeves, Sarı Gelin and more": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "On şarkı daha: özgün bir tango, The Entertainer, Greensleeves, Sarı Gelin ve dahası"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diez canciones más: un tango original, The Entertainer, Greensleeves, Sarı Gelin y más"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais dez músicas: um tango original, The Entertainer, Greensleeves, Sarı Gelin e mais"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zehn weitere Lieder: ein eigener Tango, The Entertainer, Greensleeves, Sarı Gelin und mehr"
          }
        }
      }
    },
    "The App Store is not reachable right now. Try again later.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store'a şu anda ulaşılamıyor. Daha sonra yeniden deneyin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el App Store ahora. Inténtalo más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não está acessível agora. Tente mais tarde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store ist gerade nicht erreichbar. Versuch es später noch einmal."
          }
        }
      }
    },
    "The free instrument stays complete: three registers, the classic voice, nine songs and recording.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz enstrüman eksiksizdir: üç registre, klasik ses, dokuz şarkı ve kayıt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El instrumento gratuito está completo: tres registros, la voz clásica, nueve canciones y grabación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O instrumento grátis é completo: três registros, a voz clássica, nove músicas e gravação."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kostenlose Instrument ist vollständig: drei Register, die klassische Stimme, neun Lieder und Aufnahmen."
          }
        }
      }
    },
    "The purchase did not go through. Nothing was charged.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma tamamlanmadı. Ücret alınmadı."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra no se completó. No se cobró nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra não foi concluída. Nada foi cobrado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wurde nicht abgeschlossen. Es wurde nichts berechnet."
          }
        }
      }
    },
    "The purchase is waiting for approval.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma onay bekliyor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra está esperando aprobación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra está aguardando aprovação."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wartet auf Genehmigung."
          }
        }
      }
    },
    "The strip in the middle is the bellows.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortadaki şerit körüktür."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La franja del centro es el fuelle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A faixa no meio é o fole."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Streifen in der Mitte ist der Balg."
          }
        }
      }
    },
    "Three more voices: Cassotto, Harmonium and Folk": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç ses daha: Cassotto, Armonyum ve Halk"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres voces más: Cassotto, Armonio y Folk"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais três vozes: Cassotto, Harmônio e Folk"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei weitere Stimmen: Cassotto, Harmonium und Folk"
          }
        }
      }
    },
    "Touch buttons while moving the bellows to play notes.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota çalmak için körüğü oynatırken düğmelere dokunun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa los botones mientras mueves el fuelle para tocar notas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nos botões enquanto move o fole para tocar notas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berühre die Knöpfe, während du den Balg bewegst, um Töne zu spielen."
          }
        }
      }
    },
