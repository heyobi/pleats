    "Hold iPhone Duo like a book, half open. The fold is the bellows.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Duo'yu kitap gibi, yarı açık tutun. Katlanma yeri körüktür."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostén el iPhone Duo como un libro, medio abierto. El pliegue es el fuelle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o iPhone Duo como um livro, meio aberto. A dobra é o fole."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das iPhone Duo wie ein Buch, halb geöffnet. Der Falz ist der Balg."
          }
        }
      }
    },
