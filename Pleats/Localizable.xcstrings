    "Treble buttons on one side, bass and chords on the other. Play as many as you like at once.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yanda tiz düğmeler, öbür yanda bas ve akorlar. İstediğiniz kadarına aynı anda basın."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Botones de melodía a un lado, bajos y acordes al otro. Pulsa todos los que quieras a la vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Botões de melodia de um lado, baixos e acordes do outro. Aperte quantos quiser ao mesmo tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskantknöpfe auf der einen Seite, Bässe und Akkorde auf der anderen. Drück so viele gleichzeitig, wie du willst."
          }
        }
      }
    },
