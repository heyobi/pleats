        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo Pleats, con una sola compra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o Pleats, com uma única compra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in Pleats, mit einem Kauf."
          }
        }
      }
    },
