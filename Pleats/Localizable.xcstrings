    "Pick a song and the next button lights up. Play it with air from the bellows and the song moves on. Tap the ear to hear it first.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şarkı seçin, sıradaki düğme yansın. Körükten hava vererek çalın, şarkı ilerlesin. Önce dinlemek için kulağa dokunun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una canción y se iluminará el siguiente botón. Tócalo con aire del fuelle y la canción avanza. Toca la oreja para escucharla primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma música e o próximo botão acende. Toque com ar do fole e a música avança. Toque na orelha para ouvir antes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Lied und der nächste Knopf leuchtet. Spiel ihn mit Luft aus dem Balg, dann geht das Lied weiter. Tippe auf das Ohr, um es vorher zu hören."
          }
        }
      }
