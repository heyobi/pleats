    "Open and close the hinge to pump air. Faster is louder; both directions sound.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava pompalamak için menteşeyi açıp kapatın. Hızlı hareket daha yüksek ses verir; iki yön de çalar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre y cierra la bisagra para bombear aire. Más rápido suena más fuerte; ambas direcciones suenan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra e feche a dobradiça para bombear ar. Mais rápido soa mais alto; as duas direções soam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne und schließe das Scharnier, um Luft zu pumpen. Schneller klingt lauter; beide Richtungen klingen."
